# Copy to .env.local for local dev (must match backend JWT_SECRET).
JWT_SECRET=

# Backend URL for server-side API routes (login proxy, BFF). Default: http://127.0.0.1:8000
API_URL=http://127.0.0.1:8000

# Optional: exposed to the browser if you call the API directly (prefer BFF + cookies).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Публичный URL (как на VPS), без слэша — для ссылок и NEXT_PUBLIC. На прод задаётся в корневом .env как PUBLIC_APP_URL.
# NEXT_PUBLIC_APP_URL=https://your-domain.com
