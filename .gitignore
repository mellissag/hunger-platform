# ── Secrets ───────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# ── Node / Next.js ────────────────────────────────────────────
node_modules/
.next/
out/
dist/
.npm/
*.tsbuildinfo

# ── Docker volumes / runtime data ─────────────────────────────
# data/uploads — bind-mount для загруженных медиафайлов.
# Медиафайлы живут на хосте и не должны попадать в git.
# .gitkeep позволяет git отслеживать пустую папку (для bind-mount при первом деплое).
data/uploads/*
!data/uploads/.gitkeep
/uploads/
backups/

# ── Logs ──────────────────────────────────────────────────────
*.log
logs/

# ── OS ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ───────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
