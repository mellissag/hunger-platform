# Пример: nginx (80/443 на хосте) → Caddy в Docker на 127.0.0.1:8080
# (см. deploy/docker-compose.prod.yml: CADDY_HTTP_PORT=8080 по умолчанию, CADDY_CADDYFILE=Caddyfile.prod.behind-proxy)
#
# Установка (на VPS, после certbot / SSL):
#   sudo cp deploy/nginx/hunger-beauty-behind-caddy.conf.example /etc/nginx/sites-available/hunger-beauty.conf
#   # замените test-adm.tech, пути к cert — под ваши
#   sudo ln -sf /etc/nginx/sites-available/hunger-beauty.conf /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# Проверка upstream до reload:
#   curl -sI -H "Host: test-adm.tech" http://127.0.0.1:8080/healthz

upstream hunger_caddy {
    server 127.0.0.1:8080;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name test-adm.tech www.test-adm.tech;

    location ^/.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name test-adm.tech www.test-adm.tech;

    # Замените на свои пути (certbot):
    # ssl_certificate /etc/letsencrypt/live/test-adm.tech/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/test-adm.tech/privkey.pem;
    # include /etc/letsencrypt/options-ssl-nginx.conf;
    # ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        proxy_pass http://hunger_caddy;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400;
    }
}
