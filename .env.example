# Hunger Beauty — пример переменных окружения.
# Скопируйте: cp .env.example .env
# Заполните секреты; не коммитьте .env!
#
# Генерация случайных ключей:
#   python3 -c "import secrets; print(secrets.token_hex(32))"

# ── Приложение ─────────────────────────────────────────────────
APP_DOMAIN=localhost
# Публичный URL без слэша в конце. Админка: {PUBLIC_APP_URL}/login
PUBLIC_APP_URL=https://example.com
APP_ENV=development
DEBUG=true

# Порты Caddy на хосте: на VPS обычно 80 и 443; локально — 8080/8443
# Если nginx уже слушает 80/443 — задайте 8080/8443 и проксируйте на контейнер Caddy.
# CADDY_HTTP_PORT=80
# CADDY_HTTPS_PORT=443

# ── Let's Encrypt (production, docker-compose.prod.yml) ────────
LETSENCRYPT_EMAIL=admin@example.com

# ── Telegram (см. 01_MASTER_SPEC.md §10.1) ─────────────────────
TELEGRAM_BOT_TOKEN=changeme
TELEGRAM_WEBHOOK_SECRET=changeme_replace_with_hex_32_plus

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_DB=hunger
POSTGRES_USER=hunger
POSTGRES_PASSWORD=changeme
# Async SQLAlchemy (asyncpg)
DATABASE_URL=postgresql+asyncpg://hunger:changeme@postgres:5432/hunger

# ── Redis (кеш + ARQ) ─────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT / сессии ──────────────────────────────────────────────
SECRET_KEY=changeme_replace_with_64_hex
JWT_SECRET=changeme_replace_with_64_hex

# ── Google Gemini (см. 01_MASTER_SPEC.md §2.4, §10.2) ─────────
GEMINI_API_KEY=

# ── Seed (первый запуск) ───────────────────────────────────────
SEED_PASSWORD=changeme

# ── Docker / GHCR (production) ────────────────────────────────
# owner/repo-name вашего форка (используется в docker-compose.prod.yml)
GITHUB_REPOSITORY=hunger-platform/hunger-beauty
# Версия образа: latest или vX.Y.Z
IMAGE_TAG=latest

# ── SMTP (опционально) ────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
