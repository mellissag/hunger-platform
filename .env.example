# Hunger Beauty — пример переменных окружения.
# Скопируйте: cp .env.example .env
# Заполните секреты; не коммитьте .env.

# ── Telegram (см. 01_MASTER_SPEC.md §10.1) ─────────────────────
TELEGRAM_BOT_TOKEN=changeme
TELEGRAM_WEBHOOK_SECRET=changeme_replace_with_hex_32_plus

# ── Приложение ─────────────────────────────────────────────────
APP_DOMAIN=localhost
APP_ENV=development
DEBUG=true

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_DB=hunger
POSTGRES_USER=hunger
POSTGRES_PASSWORD=changeme
# Async SQLAlchemy (asyncpg)
DATABASE_URL=postgresql+asyncpg://hunger:changeme@postgres:5432/hunger

# ── Redis (кеш + ARQ) ─────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT / сессии ──────────────────────────────────────────────
SECRET_KEY=changeme_replace_with_64_hex
JWT_SECRET=changeme_replace_with_64_hex

# ── Google Gemini (см. 01_MASTER_SPEC.md §2.4, §10.2) ─────────
GEMINI_API_KEY=

# ── Seed (после появления seed-скриптов) ──────────────────────
SEED_PASSWORD=changeme

# ── SMTP (опционально) ───────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
